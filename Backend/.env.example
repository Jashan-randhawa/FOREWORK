# --- Core ---
NODE_ENV=development
PORT=5001
MONGO_URI=
JWT_SECRET=
FRONTEND_URL=http://localhost:5173

# --- Cloudinary (image uploads) ---
CLOUD_NAME=
CLOUD_API=
